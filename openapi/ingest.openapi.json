        "tags": [
          "UsageIngestionService"
        ],
        "summary": "IngestUsage accepts one idempotent usage event.",
        "operationId": "UsageIngestionService_IngestUsage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "$ref": "#/components/schemas/railzway.fare.ingest.v1.UsageEvent"
                  },
                  "parent": {
                    "type": "string"
                  }
                },
                "required": [
                  "parent",
                  "event"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "IngestUsageResponse reports the accepted event and ingestion status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/railzway.fare.ingest.v1.IngestUsageResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request is malformed or contains an invalid argument.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/railzway.api.ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_ARGUMENT",
                    "message": "The request contains an invalid argument",
                    "details": []
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication is missing, expired, revoked, or otherwise invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/railzway.api.ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "A valid API key is required",
                    "details": []
                  }
                }
              }
            }
          },
          "403": {
            "description": "The credential is valid but lacks permission for this operation or organization.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/railzway.api.ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "PERMISSION_DENIED",
                    "message": "Permission denied",
                    "details": []
                  }
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response using Fare's stable HTTP error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/railzway.api.ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL",
                    "message": "Internal server error",
                    "details": []
