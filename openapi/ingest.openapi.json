            }
          },
          "nextPageToken": {
            "type": "string"
          }
        }
      },
      "railzway.fare.ingest.v1.ReplayUsageEventsResponse": {
        "type": "object",
        "description": "ReplayUsageEventsResponse reports how many events were scheduled.",
        "properties": {
          "matchedEventCount": {
            "type": "string",
            "format": "int64",
            "readOnly": true
          },
          "replayId": {
            "type": "string",
            "readOnly": true
          },
          "watermarkTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "railzway.fare.ingest.v1.UsageEvent": {
        "type": "object",
        "description": "UsageEvent is an immutable measurement submitted for billing.",
        "properties": {
          "correctionOf": {
            "type": "string",
            "readOnly": true
          },
          "customer": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "eventType": {
            "type": "string"
          },
          "ingestTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/railzway.fare.ingest.v1.IngestionStatus"
              }
            ],
            "readOnly": true
          }
        },
        "required": [
          "eventId",
          "customer",
          "eventType",
          "eventTime"
        ]
      },
      "railzway.api.ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Request field that failed validation."
          },
          "rule": {
            "type": "string",
            "description": "Stable validation rule identifier."
          },
          "message": {
            "type": "string",
            "description": "Developer-facing validation message."
          }
        },
        "required": [
          "field",
          "rule",
          "message"
        ]
      },
      "railzway.api.Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable application error code, for example INVALID_ARGUMENT."
          },
          "message": {
            "type": "string",
            "description": "Developer-facing error message."
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/railzway.api.ErrorDetail"
            }
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "railzway.api.ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/railzway.api.Error"
          }
        },
        "required": [
          "error"
        ]
      }
