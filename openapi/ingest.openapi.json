  "components": {
    "schemas": {
      "railzway.fare.ingest.v1.BatchIngestUsageResponse": {
        "type": "object",
        "description": "BatchIngestUsageResponse contains the result for each submitted event.",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/railzway.fare.ingest.v1.IngestUsageResponse"
            }
          }
        }
      },
      "railzway.fare.ingest.v1.IngestUsageResponse": {
        "type": "object",
        "description": "IngestUsageResponse reports the accepted event and ingestion status.",
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/railzway.fare.ingest.v1.IngestionStatus"
          },
          "usageEvent": {
            "type": "string"
          }
        }
      },
      "railzway.fare.ingest.v1.IngestionStatus": {
        "type": "string",
        "description": "IngestionStatus describes the processing outcome of a usage event.",
        "enum": [
          "INGESTION_STATUS_UNSPECIFIED",
          "INGESTION_STATUS_ACCEPTED",
          "INGESTION_STATUS_DUPLICATE",
          "INGESTION_STATUS_REJECTED",
          "INGESTION_STATUS_CORRECTED"
        ]
      },
      "railzway.fare.ingest.v1.ListUsageEventsResponse": {
        "type": "object",
        "description": "ListUsageEventsResponse contains a page of usage events.",
