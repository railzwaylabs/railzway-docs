  "components": {
    "schemas": {
      "railzway.fare.meter.v1.AggregationType": {
        "type": "string",
        "description": "AggregationType defines how matching usage values are combined.",
        "enum": [
          "AGGREGATION_TYPE_UNSPECIFIED",
          "AGGREGATION_TYPE_COUNT",
          "AGGREGATION_TYPE_SUM",
          "AGGREGATION_TYPE_MAX",
          "AGGREGATION_TYPE_UNIQUE_COUNT",
          "AGGREGATION_TYPE_LATEST"
        ]
      },
      "railzway.fare.meter.v1.ListMetersResponse": {
        "type": "object",
        "description": "ListMetersResponse contains a page of meters.",
        "properties": {
          "meters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/railzway.fare.meter.v1.Meter"
            }
          },
          "nextPageToken": {
            "type": "string"
          }
        }
      },
      "railzway.fare.meter.v1.Meter": {
        "type": "object",
        "description": "Meter defines how usage events are filtered, grouped, and aggregated.",
        "properties": {
          "aggregation": {
            "$ref": "#/components/schemas/railzway.fare.meter.v1.AggregationType"
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "displayName": {
            "type": "string"
          },
          "eventType": {
            "type": "string"
          },
          "groupKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "valueProperty": {
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "eventType",
          "aggregation"
        ]
      },
      "railzway.api.ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "rule",
          "message"
        ]
      },
      "railzway.api.Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_ARGUMENT"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/railzway.api.ErrorDetail"
            }
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "railzway.api.ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/railzway.api.Error"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "MeterService",
      "description": "MeterService manages definitions used to aggregate usage events."
    }
  ]
