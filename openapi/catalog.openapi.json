  "components": {
    "schemas": {
      "railzway.common.v1.Decimal": {
        "type": "object",
        "description": "Decimal is a canonical base-10 value. Scientific notation, leading plus\nsigns, and insignificant leading or trailing zeros are not allowed.",
        "properties": {
          "value": {
            "type": "string",
            "description": "Canonical decimal representation, for example \"0\", \"12.5\", or \"-0.01\"."
          }
        },
        "required": [
          "value"
        ]
      },
      "railzway.common.v1.EffectivePeriod": {
        "type": "object",
        "description": "EffectivePeriod is a half-open validity interval: [start_time, end_time).",
        "properties": {
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "Exclusive end of the validity interval. If unset, the interval has no\nscheduled end. When set, it must be later than start_time."
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "Inclusive start of the validity interval. The value must be in UTC."
          }
        },
        "required": [
          "startTime"
        ]
      },
      "railzway.common.v1.Money": {
        "type": "object",
        "description": "Money is an exact monetary value in an ISO 4217 currency.",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/railzway.common.v1.Decimal",
            "description": "Exact amount in the specified currency."
          },
          "currencyCode": {
            "type": "string",
            "description": "Three-letter ISO 4217 currency code."
          }
        },
        "required": [
          "currencyCode",
          "amount"
        ]
      },
      "railzway.fare.catalog.v1.FlatRate": {
        "type": "object",
        "description": "FlatRate charges a fixed amount independently of quantity.",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/railzway.common.v1.Money"
          }
        },
        "required": [
          "amount"
        ]
      },
      "railzway.fare.catalog.v1.ListProductsResponse": {
        "type": "object",
        "description": "ListProductsResponse contains one page of products.",
        "properties": {
          "nextPageToken": {
            "type": "string"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/railzway.fare.catalog.v1.Product"
            }
          }
        }
      },
      "railzway.fare.catalog.v1.ListRateCardsResponse": {
        "type": "object",
        "description": "ListRateCardsResponse contains one page of rate cards.",
        "properties": {
          "nextPageToken": {
            "type": "string"
          },
          "rateCards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/railzway.fare.catalog.v1.RateCard"
            }
          }
        }
      },
      "railzway.fare.catalog.v1.PackageRate": {
        "type": "object",
        "description": "PackageRate charges by fixed-size packages of quantity.",
        "properties": {
          "packagePrice": {
            "$ref": "#/components/schemas/railzway.common.v1.Money"
          },
          "packageSize": {
            "$ref": "#/components/schemas/railzway.common.v1.Decimal"
          }
        },
        "required": [
          "packageSize",
          "packagePrice"
        ]
      },
      "railzway.fare.catalog.v1.Product": {
        "type": "object",
        "description": "Product is a sellable SKU and the basic unit of an invoice line.",
        "properties": {
          "createTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "displayName": {
            "type": "string"
          },
          "meter": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "presentationGroupKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pricingGroupKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "$ref": "#/components/schemas/railzway.fare.catalog.v1.ProductType"
          }
        },
        "required": [
          "displayName",
          "type"
        ]
      },
      "railzway.fare.catalog.v1.ProductType": {
        "type": "string",
        "description": "ProductType identifies how a product contributes charges to an invoice.",
        "enum": [
          "PRODUCT_TYPE_UNSPECIFIED",
          "PRODUCT_TYPE_USAGE",
          "PRODUCT_TYPE_SUBSCRIPTION",
          "PRODUCT_TYPE_FIXED",
          "PRODUCT_TYPE_COMPOSITE"
        ]
      },
      "railzway.fare.catalog.v1.Rate": {
        "type": "object",
        "description": "Rate assigns one pricing model to a product for a non-overlapping period.",
        "properties": {
          "dimensionValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "effectivePeriod": {
            "$ref": "#/components/schemas/railzway.common.v1.EffectivePeriod"
          },
          "flat": {
            "$ref": "#/components/schemas/railzway.fare.catalog.v1.FlatRate"
          },
          "id": {
            "type": "string",
            "readOnly": true
          },
          "package": {
            "$ref": "#/components/schemas/railzway.fare.catalog.v1.PackageRate"
          },
          "product": {
            "type": "string"
          },
          "tiered": {
            "$ref": "#/components/schemas/railzway.fare.catalog.v1.TieredRate"
          },
          "unit": {
            "$ref": "#/components/schemas/railzway.fare.catalog.v1.UnitRate"
          }
        },
        "required": [
